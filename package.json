{
  "name": "plugin_name",
  "version": "1.2.6",
  "description": "A WordPress boilerplate plugin using vue.js",
  "main": "index.js",
  "scripts": {
    "dev": "node src/env/development_mode.js && vite",
    "watch": "npm run dev",
    "test": "php tests/run.php",
    "test:http": "bash tests/http-smoke.sh",
    "test:all": "npm test && npm run test:http && npm run build",
    "build": "node src/env/production_mode.js && vite build",
    "build:zip": "npm run package",
    "production": "npm run build",
    "package": "npm run build && mkdir -p builds && rm -f builds/buy-me-coffee.zip && zip -r builds/buy-me-coffee.zip assets buy-me-coffee.php includes index.php languages license.txt readme.txt -x '*/.DS_Store' '__MACOSX/*'"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.0.9",
    "@wordpress/hooks": "^3.1.1",
    "chart.js": "^4.4.0",
    "element-plus": "^2.13.7",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.2.39",
    "vue-router": "^4.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/compiler-sfc": "^3.2.39",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "react": "^18.2.0",
    "sass": "^1.35.1",
    "tailwindcss": "^3.4.14",
    "unplugin-auto-import": "^0.11.5",
    "unplugin-vue-components": "^0.22.12",
    "vite": "^8.0.10",
    "vite-plugin-live-reload": "^2.1.0",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
